# Copy to .env.worker on the seller laptop. No shared disk or database needed.
# Use the marketplace laptop's LAN IP when running on two computers.
MARKETPLACE_URL=http://localhost:3001
SELLER_HANDLE=studio.aure
SELLER_WORKER_TOKEN=replace-with-the-matching-marketplace-token
WORKER_NAME=Studio Aure seller laptop
WORKER_PORT=4001
# Optional demo pacing and local PNG output directory
WORKER_DEMO_DELAY_MS=6000
# WORKER_OUTPUT_DIR=./worker-data
