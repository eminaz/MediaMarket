# Optional: npm run seller works without this file.
# For two laptops, only MARKETPLACE_URL needs changing to the buyer laptop's LAN IP.
MARKETPLACE_URL=http://localhost:3001
SELLER_HANDLE=studio.aure
SELLER_WORKER_TOKEN=local-demo-secret-1234
WORKER_NAME=Studio Aure seller laptop
WORKER_PORT=4001
# Optional demo pacing and local PNG output directory
WORKER_DEMO_DELAY_MS=6000
# WORKER_OUTPUT_DIR=./worker-data

# Auto-detects ~/Pictures/local-image-gen/generate.sh; uses mock if absent.
# No API key needed. Your model, Python environment, and model cache must be ready.
# SELLER_GENERATOR=auto
# Force mock: SELLER_GENERATOR=mock. Force local (fail if missing): SELLER_GENERATOR=local.
# LOCAL_GENERATOR_SCRIPT=/absolute/path/to/generate.sh
# LOCAL_GENERATOR_STEPS=4
# LOCAL_GENERATOR_SEED=42
# LOCAL_GENERATOR_WIDTH=768
# LOCAL_GENERATOR_HEIGHT=768
# LOCAL_GENERATOR_TIMEOUT_MS=180000
