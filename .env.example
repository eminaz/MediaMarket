# No credentials needed for the default local demo.
GENERATION_MODE=mock
# Set mode to auto (use key if present) or openai (require key) for live edits.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional; defaults to ./data
# DATA_DIR=./data

# Separate seller-laptop execution (local is the default)
EXECUTION_MODE=local
# For worker mode, set EXECUTION_MODE=worker and configure seller-specific tokens.
# Use a different random token (16+ characters) for each seller.
# SELLER_WORKER_TOKENS={"studio.aure":"replace-with-a-random-secret"}
